---
import "aos/dist/aos.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Alexis Sierra | Desarrollador Frontend Junior - Portfolio",
  description = "Portafolio profesional de Alexis Sierra, Desarrollador Frontend Junior especializado en Angular 19, TypeScript, Vue.js, Ionic y Tailwind CSS.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Alexis Sierra" />
    <meta
      name="keywords"
      content="Alexis Sierra, Frontend Developer, Angular 19, Vue.js, TypeScript, Ionic, Tailwind CSS, Portafolio Web, Desarrollador Web"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/imagen/foto.jpeg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/imagen/foto.jpeg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-white text-slate-800 min-h-screen relative selection:bg-brand-100 selection:text-brand-800"
  >
    <!-- Ambient Background Lighting for Light Theme -->
    <div
      class="fixed inset-0 pointer-events-none z-0 overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="absolute -top-40 -left-40 w-96 h-96 bg-brand-500/8 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute top-1/3 -right-40 w-96 h-96 bg-brand-600/8 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute -bottom-40 left-1/3 w-96 h-96 bg-brand-400/5 rounded-full blur-3xl"
      >
      </div>
      <!-- Subtle Clean Grid Pattern -->
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#0f172a08_1px,transparent_1px),linear-gradient(to_bottom,#0f172a08_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_70%_50%_at_50%_0%,#000_70%,transparent_100%)]"
      >
      </div>
    </div>

    <!-- Main Content Slot -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- Script de inicialización de AOS -->
    <script>
      import AOS from "aos";

      document.addEventListener("DOMContentLoaded", () => {
        AOS.init({
          duration: 800,
          once: true,
          easing: "ease-out-cubic",
        });
      });
    </script>
  </body>
</html>
