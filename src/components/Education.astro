---

<section
  data-aos="fade-up"
  data-aos-duration="800"
  id="educacion"
  class="py-16 sm:py-24 relative bg-white overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
     
      <h2 class="text-2xl sm:text-4xl font-bold text-slate-900 mt-2 tracking-tight">
        Formación & Certificaciones
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Validación técnica y especializaciones completadas con éxito.
      </p>
      <div class="w-16 h-1 bg-[#023e7d] mx-auto mt-3 rounded-full"></div>
    </div>

    <!-- Responsive Grid: 1 col on mobile, 2 on tablet, 3 on desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {certifications.map((cert) => (
        <div class={`glass-panel glass-panel-hover p-6 rounded-2xl border border-slate-200/90 bg-white flex flex-col justify-between group transition-all duration-300 shadow-sm ${cert.iconGlow}`}>
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <!-- Large Technology Logo Container -->
              <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center bg-slate-50 border border-slate-200 shadow-sm group-hover:scale-110 transition-all duration-300 p-2.5 flex-shrink-0">
                <Fragment set:html={cert.iconSvg} />
              </div>
              
              <div class="min-w-0 flex-1">
                <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-brand-700 transition-colors leading-tight">
                  {cert.title}
                </h3>
                <p class="text-xs font-mono font-medium text-brand-700 mt-1">
                  {cert.category}
                </p>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {cert.description}
            </p>
          </div>

          <div class="pt-4 mt-5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span class="flex items-center gap-1.5 text-brand-700 font-semibold">
              <svg class="w-4 h-4 text-brand-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6" />
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
              </svg>
              <span>Certificado</span>
            </span>
            <span class="px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-blue-50 text-brand-700 border border-blue-200">
              {cert.level}
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>


