---
const highlights = [
  {
    icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" stroke="#023E7D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    bgColor: "bg-blue-50 border-blue-200",
    title: "Desarrollo Frontend Moderno",
    description:
      "Especialista en Angular 19 (Signals, Standalone Components), Vue.js y TypeScript para construir aplicaciones web ágiles y mantenibles.",
  },
  {
    icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" stroke="#0353A4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="18" r="1" fill="#0466C8"/></svg>`,
    bgColor: "bg-sky-50 border-sky-200",
    title: "Diseño Responsivo Mobile-First",
    description:
      "Maquetación precisa y adaptativa para cualquier pantalla con Tailwind CSS, CSS Grid/Flexbox y microinteracciones fluidas.",
  },
  {
    icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke="#0284C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    bgColor: "bg-cyan-50 border-cyan-200",
    title: "Integración de APIs & Estado",
    description:
      "Consumo eficiente de servicios RESTful, programación reactiva con RxJS y gestión centralizada de datos para flujos en tiempo real.",
  },
  {
    icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    bgColor: "bg-emerald-50 border-emerald-200",
    title: "Calidad & Buenas Prácticas",
    description:
      "Escritura de código tipado y estructurado, control de versiones con Git/GitHub y optimización constante de rendimiento web.",
  },
];
---

<section
  data-aos="fade-up"
  data-aos-duration="800"
  id="sobre-mi"
  class="py-16 sm:py-24 relative bg-slate-50/70 border-y border-slate-200/60 overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
      <h2
        class="text-2xl sm:text-4xl font-bold text-slate-900 mt-2 tracking-tight"
      >
        Sobre Mí & Enfoque Profesional
      </h2>
      <div class="w-16 h-1 bg-[#023e7d] mx-auto mt-3 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Bio Narrative Column -->
      <div
        class="lg:col-span-6 space-y-5 text-slate-700 text-base sm:text-lg leading-relaxed"
      >
        <p>
          ¡Hola! Soy <strong class="text-slate-900 font-semibold"
            >Alexis Sierra</strong
          >, Desarrollador Frontend apasionado por dar vida a ideas complejas a
          través de interfaces intuitivas, rápidas y visualmente atractivas.
        </p>
        <p class="text-slate-600">
          Mi especialidad radica en el ecosistema de <span
            class="text-brand-700 font-semibold">TypeScript</span
          >, construyendo aplicaciones de una sola página (SPAs) y aplicaciones
          híbridas (PWA y móviles) utilizando <span
            class="text-slate-900 font-medium">Angular 19</span
          >, <span class="text-slate-900 font-medium">Vue.js</span> e <span
            class="text-slate-900 font-medium">Ionic</span
          >
        </p>
        <p class="text-slate-600">
          Me enfoco en ofrecer una experiencia de usuario sin fricciones,
          implementando arquitecturas reactivas con <span
            class="text-slate-900 font-medium">Angular Signals</span
          >, diseño responsive con <span class="text-slate-900 font-medium"
            >Tailwind CSS</span
          > y consumo de APIs RESTful optimizadas.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-3">
          <div
            class="glass-panel bg-white px-4 py-2.5 rounded-xl border border-slate-200 flex items-center gap-2.5 shadow-sm"
          >
            <span class="text-brand-700 font-bold text-xl">+10</span>
            <span class="text-xs text-slate-600 font-medium"
              >Certificaciones Técnicas</span
            >
          </div>
          <div
            class="glass-panel bg-white px-4 py-2.5 rounded-xl border border-slate-200 flex items-center gap-2.5 shadow-sm"
          >
            <span class="text-brand-700 font-bold text-xl">100%</span>
            <span class="text-xs text-slate-600 font-medium"
              >Compromiso con Calidad</span
            >
          </div>
        </div>
      </div>

      <!-- Highlights Grid Column -->
      <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          highlights.map((item) => (
            <div class="glass-panel glass-panel-hover p-5 rounded-2xl border border-slate-200/90 bg-white group">
              <div
                class={`w-12 h-12 rounded-xl ${item.bgColor} border flex items-center justify-center mb-4 group-hover:scale-110 transition-all shadow-sm`}
                set:html={item.icon}
              />
              <h3 class="text-base font-bold text-slate-900 mb-1.5 group-hover:text-brand-700 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
