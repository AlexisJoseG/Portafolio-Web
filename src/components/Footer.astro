---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white py-10 relative z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      
      <!-- Brand & Copy -->
      <div class="space-y-1">
        <a href="#inicio" class="flex items-center justify-center md:justify-start gap-2 text-slate-900 font-bold tracking-tight text-base hover:text-brand-700 transition-colors">
          <span class="w-2.5 h-2.5 rounded-full bg-[#023e7d]"></span>
          Alexis Sierra • Frontend Developer
        </a>
        <p class="text-xs text-slate-500">
          © {currentYear} Todos los derechos reservados. Construido con Astro & Tailwind CSS.
        </p>
      </div>

      <!-- Quick Nav Links -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs text-slate-600 font-medium">
        <a href="#inicio" class="hover:text-brand-700 transition-colors">Inicio</a>
        <span>•</span>
        <a href="#sobre-mi" class="hover:text-brand-700 transition-colors">Sobre Mí</a>
        <span>•</span>
        <a href="#habilidades" class="hover:text-brand-700 transition-colors">Habilidades</a>
        <span>•</span>
        <a href="#proyectos" class="hover:text-brand-700 transition-colors">Proyectos</a>
        <span>•</span>
        <a href="#educacion" class="hover:text-brand-700 transition-colors">Educación</a>
        <span>•</span>
        <a href="#contacto" class="hover:text-brand-700 transition-colors">Contacto</a>
      </div>

      <!-- Back to top button -->
      <div>
        <a
          href="#inicio"
          aria-label="Volver arriba"
          class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 hover:text-brand-700 hover:border-brand-300 hover:bg-slate-100 transition-all flex items-center justify-center min-w-[44px] min-h-[44px] shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</footer>

