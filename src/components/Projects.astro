---
const projects = [
  {
    title: 'Catálogo E-Commerce Enterprise',
    subtitle: 'Angular 19 & Tailwind CSS',
    featured: true,
    description: 'Explorador de productos interactivo enfocado en rendimiento de alto nivel y arquitectura moderna. Implementa navegación por categorías, filtrado en tiempo real, carrito de compras reactivo y consumo asíncrono de API externa.',
    highlights: [
      'Arquitectura basada en Standalone Components de Angular 19',
      'Gestión de estado reactivo mediante Angular Signals y RxJS Observables',
      'Consumo en tiempo real de Platzi Fake Store REST API',
      'Diseño 100% responsivo y adaptativo con Tailwind CSS'
    ],
    tags: ['Angular 19', 'Tailwind CSS', 'TypeScript', 'Signals', 'RxJS', 'Platzi API'],
    codeUrl: 'https://github.com/AlexisJoseG',
    liveUrl: 'https://github.com/AlexisJoseG',
  },
  {
    title: 'Dashboard de Gestión Multiplataforma',
    subtitle: 'Vue.js & REST API',
    featured: false,
    description: 'Panel de administración dinámico con métricas en tiempo real, gestión de usuarios y productos, interfaz intuitiva y validación exhaustiva de formularios.',
    highlights: [
      'Componentes modulares con Vue 3 Composition API',
      'Integración con Axios y endpoints autenticados',
      'Gráficas interactivas y exportación de datos'
    ],
    tags: ['Vue.js', 'TypeScript', 'Tailwind CSS', 'Axios', 'REST API'],
    codeUrl: 'https://github.com/AlexisJoseG',
    liveUrl: 'https://github.com/AlexisJoseG',
  },
  {
    title: 'App Móvil Híbrida de Servicios',
    subtitle: 'Ionic & Angular',
    featured: false,
    description: 'Aplicación móvil multiplataforma para reserva de servicios, geolocalización, notificaciones y almacenamiento local con SQLite para funcionamiento offline.',
    highlights: [
      'Desarrollo con Ionic Framework y Capacitor',
      'Persistencia de datos local con SQLite',
      'Experiencia nativa fluida en iOS y Android'
    ],
    tags: ['Ionic', 'Angular', 'Capacitor', 'SQLite', 'Mobile-First'],
    codeUrl: 'https://github.com/AlexisJoseG',
    liveUrl: 'https://github.com/AlexisJoseG',
  }
];
---

<section
  data-aos="fade-up"
  data-aos-duration="800"
  id="proyectos"
  class="py-16 sm:py-24 relative bg-slate-50/70 border-y border-slate-200/60 overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
      
      <h2 class="text-2xl sm:text-4xl font-bold text-slate-900 mt-2 tracking-tight">
        Proyectos Destacados
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Soluciones prácticas construidas con los más altos estándares de desarrollo frontend.
      </p>
      <div class="w-16 h-1 bg-[#023e7d] mx-auto mt-3 rounded-full"></div>
    </div>

    <!-- Featured Project: Catálogo E-Commerce Enterprise -->
    <div class="mb-12">
      {projects.filter(p => p.featured).map((project) => (
        <div class="glass-panel rounded-3xl p-6 sm:p-8 lg:p-10 border border-blue-200/80 bg-white relative overflow-hidden group shadow-md hover:shadow-xl transition-all duration-300">
          <!-- Ambient card subtle tint -->
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-brand-500/5 rounded-full blur-3xl pointer-events-none group-hover:bg-brand-500/10 transition-all"></div>
          
          <div class="flex flex-col lg:flex-row gap-8 items-center justify-between">
            <div class="space-y-4 flex-1">
              <div class="flex items-center gap-3">
                <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#023e7d] text-white shadow-sm">
                  Proyecto Principal
                </span>
                <span class="text-xs font-mono font-medium text-brand-700">
                  {project.subtitle}
                </span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight group-hover:text-brand-700 transition-colors">
                {project.title}
              </h3>

              <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                {project.description}
              </p>

              <!-- Technical Highlights -->
              <div class="space-y-2 pt-2">
                <p class="text-xs font-mono text-brand-700 font-bold uppercase tracking-wider">Características Clave:</p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm text-slate-700">
                  {project.highlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-brand-700 font-bold mt-0.5">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 pt-3">
                {project.tags.map((tag) => (
                  <span class="px-3 py-1 rounded-lg bg-slate-100 border border-slate-200/80 text-slate-700 text-xs font-mono font-medium">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- CTA Links -->
              <div class="flex flex-wrap items-center gap-4 pt-4">
                 <a
                  href={"https://alexisjoseg.github.io/angular-ecommerce/catalog"}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold text-white bg-[#023e7d] hover:bg-[#0353a4] rounded-xl transition-all shadow-md shadow-brand-700/20 min-h-[44px]"
                >
                  
                  <span>Ver Catálogo</span>
                </a>
                <a
                  href="https://github.com/AlexisJoseG/angular-ecommerce"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold text-white bg-[#023e7d] hover:bg-[#0353a4] rounded-xl transition-all shadow-md shadow-brand-700/20 min-h-[44px]"
                >
                  <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  <span>Ver en GitHub</span>
                </a>

                <a
                  href="https://wa.me/584245202701?text=Hola%20Alexis,%20me%20interesó%20tu%20proyecto%20de%20Catálogo%20E-Commerce."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:text-brand-700 bg-white border border-slate-200 hover:border-brand-300 rounded-xl transition-all shadow-sm min-h-[44px]"
                >
                  <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                  <span>Consultar sobre este proyecto</span>
                </a>
              </div>
            </div>

            <!-- Architecture Mock Preview Box -->
            <div class="w-full lg:w-96 rounded-2xl border border-slate-800 bg-slate-900 p-5 font-mono text-xs text-slate-300 space-y-3 shadow-lg">
              <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                <span class="text-blue-400 font-semibold">architecture.spec.ts</span>
                <span class="flex gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                </span>
              </div>
              <p class="text-slate-200"><span class="text-red-400 font-bold">@Component</span>({'{'}</p>
              <p class="pl-4">standalone: <span class="text-emerald-400">true</span>,</p>
              <p class="pl-4">changeDetection: <span class="text-sky-300">OnPush</span>,</p>
              <p class="pl-4">signals: [<span class="text-amber-300">'cart$'</span>, <span class="text-amber-300">'products$'</span>]</p>
              <p class="text-slate-200">{'}'})</p>
              <div class="pt-2 border-t border-slate-800 text-[11px] text-slate-400">
                ⚡ Consumo reactivo Platzi Fake Store API
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Secondary Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.filter(p => !p.featured).map((project) => (
        <div class="glass-panel glass-panel-hover p-6 rounded-2xl border border-slate-200/90 bg-white flex flex-col justify-between group shadow-sm">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-brand-700">{project.subtitle}</span>
              <a
                href={project.codeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-500 hover:text-brand-700 transition-colors p-1"
                aria-label="Ver código en GitHub"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              </a>
            </div>

            <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
              {project.title}
            </h3>

            <p class="text-slate-600 text-sm leading-relaxed">
              {project.description}
            </p>

            <ul class="space-y-1.5 pt-1 text-xs text-slate-700">
              {project.highlights.map((h) => (
                <li class="flex items-center gap-1.5">
                  <span class="text-brand-700 font-bold">▹</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap gap-2 pt-4 mt-4 border-t border-slate-100">
            {project.tags.map((tag) => (
              <span class="px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200/80 text-slate-600 text-[11px] font-mono">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

