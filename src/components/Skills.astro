---

<section
  data-aos="fade-up"
  data-aos-duration="800"
  id="habilidades"
  class="py-16 sm:py-24 relative bg-slate-50/50 border-t border-slate-200/60 overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
      <h2 class="text-2xl sm:text-4xl font-bold text-slate-900 mt-2 tracking-tight">
        Habilidades & Tecnologías
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Herramientas y tecnologías que domino para el desarrollo de soluciones web completas y escalables.
      </p>
      <div class="w-16 h-1 bg-[#023e7d] mx-auto mt-3 rounded-full"></div>
    </div>

    <!-- Skills Grid (Responsive 1 -> 2 -> 3 columns) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {skillCategories.map((category) => (
        <div class="glass-panel glass-panel-hover p-5 sm:p-6 rounded-2xl border border-slate-200/90 bg-white flex flex-col justify-between group shadow-sm hover:shadow-md transition-all duration-300">
          <div>
            <!-- Category Header -->
            <div class="flex items-center gap-2.5 mb-5 pb-3 border-b border-slate-100">
              <span class="w-2.5 h-2.5 rounded-full bg-[#023e7d]"></span>
              <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
                {category.title}
              </h3>
            </div>

            <!-- Skill Items with Icon, Title, Description and Badge -->
            <div class="flex flex-col gap-3">
              {category.skills.map((skill) => (
                <div class={`p-3 rounded-xl border transition-all duration-200 flex items-start gap-3 group/item ${
                  skill.highlight
                    ? 'bg-blue-50/50 border-blue-200/80 hover:border-brand-400 hover:bg-blue-50/90 hover:shadow-sm'
                    : 'bg-white border-slate-200/70 hover:border-slate-300 hover:bg-slate-50/80 hover:shadow-sm'
                }`}>
                  <!-- Technology Icon -->
                  <div class="p-1.5 rounded-lg bg-white border border-slate-100 shadow-xs flex-shrink-0 mt-0.5 group-hover/item:scale-105 transition-transform">
                    <span class="block" set:html={skill.iconSvg} />
                  </div>
                  
                  <!-- Info Container -->
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2 mb-0.5">
                      <h4 class="text-xs sm:text-sm font-bold text-slate-900 truncate">
                        {skill.name}
                      </h4>
                      <span class={`text-[10px] px-2 py-0.5 rounded-full font-mono font-medium flex-shrink-0 ${
                        skill.highlight
                          ? 'bg-[#023e7d] text-white'
                          : 'bg-slate-100 text-slate-600 border border-slate-200/60'
                      }`}>
                        {skill.badge}
                      </span>
                    </div>
                    <p class="text-[11px] sm:text-xs text-slate-600 leading-snug font-normal">
                      {skill.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>


