---
import { Image } from "astro:assets";
import profileImage from "../assets/profile.jpg";
---

<section
  id="inicio"
  class="relative pt-28 pb-16 sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-32 overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-16"
    >
      <!-- Text & Intro Column -->
      <div class="flex-1 text-center lg:text-left space-y-6 sm:space-y-8">
        <!-- Main Title with Typewriter Animation -->
        <div class="space-y-3">
          <h2
            class="text-xl sm:text-2xl lg:text-3xl text-slate-700 font-bold tracking-tight"
          >
            Hola, soy <span
              class="text-slate-900 font-extrabold text-gradient-blue"
              >Alexis Sierra</span
            >
          </h2>
          <h1
            class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight min-h-[3.8rem] sm:min-h-[5.5rem] lg:min-h-[7.5rem] break-words"
          >
            <span id="typewriter-text" class="text-gradient"></span><span
              id="typewriter-cursor"
              class="inline-block w-1 sm:w-1.5 h-6 sm:h-9 lg:h-12 bg-brand-700 ml-1 animate-pulse align-baseline"
            ></span>
          </h1>
        </div>

        <!-- Subtitle -->
        <p
          class="text-base sm:text-lg lg:text-xl text-slate-600 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed"
        >
          <strong class="text-slate-900 font-semibold"
            >Desarrollador Frontend Junior</strong
          > especializado en <span class="text-brand-700 font-semibold"
            >TypeScript</span
          >, <span class="text-brand-700 font-semibold">Angular 19</span>, <span
            class="text-brand-700 font-semibold">Vue.js</span
          > e <span class="text-brand-700 font-semibold">Ionic</span>. Construyo
          interfaces dinámicas, responsivas y de alto rendimiento.
        </p>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2"
        >
          <a
            href="https://wa.me/584245202701?text=Hola%20Alexis,%20vi%20tu%20portafolio%20y%20me%20gustaría%20contactarte."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-3.5 text-sm sm:text-base font-bold text-white bg-[#023e7d] hover:bg-[#0353a4] rounded-xl transition-all duration-200 transform hover:-translate-y-0.5 shadow-lg shadow-brand-700/25 min-h-[44px]"
          >
            <span>Hablemos por WhatsApp</span>
            <svg
              class="w-5 h-5 text-[#25D366]"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
              ></path>
            </svg>
          </a>

          <a
            href="#proyectos"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 text-sm sm:text-base font-semibold text-slate-700 hover:text-brand-700 bg-white hover:bg-slate-50 border border-slate-200 hover:border-brand-300 rounded-xl transition-all duration-200 shadow-sm min-h-[44px]"
          >
            <span>Ver Proyectos</span>
            <svg
              class="w-4 h-4 text-brand-700"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Avatar & Graphic Column -->
      <div
        class="flex-shrink-0 flex flex-col justify-center items-center gap-6 -mt-2 sm:-mt-4 lg:-mt-10"
      >
        <div class="relative group">
          <!-- Outer Ambient Glow -->
          <div
            class="absolute -inset-2 bg-gradient-to-r from-brand-600/20 to-blue-400/20 rounded-full blur-xl opacity-75 group-hover:opacity-100 transition duration-500"
          >
          </div>

          <!-- Gradient Ring -->
          <div
            class="relative p-1.5 rounded-full bg-gradient-to-tr from-brand-700 via-blue-400 to-indigo-500 shadow-xl"
          >
            <div class="p-1 rounded-full bg-white">
              <Image
                src={profileImage}
                alt="Alexis Sierra - Desarrollador Frontend"
                class="w-[9.25rem] h-[9.25rem] sm:w-[12.5rem] sm:h-[12.5rem] lg:w-[14.5rem] lg:h-[14.5rem] rounded-full object-cover object-center transform group-hover:scale-[1.02] transition duration-300"
                loading="eager"
              />
            </div>
          </div>

          <!-- Decorative Floating Pill -->
          <div
            class="absolute -bottom-2 sm:-bottom-4 left-1/2 transform -translate-x-1/2 glass-panel px-3.5 py-1.5 rounded-full border border-slate-200 flex items-center gap-1.5 shadow-md whitespace-nowrap bg-white/95"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-[#023e7d]"></span>
            <span class="text-xs font-mono font-medium text-slate-700"
              >Angular 19 • Vue • TS</span
            >
          </div>
        </div>

        <!-- Social Quick Links Bar (Below Photo) -->
        <div class="flex items-center justify-center gap-3 pt-3 sm:pt-4">
          <!-- GitHub (Original Dark) -->
          <a
            href="https://github.com/AlexisJoseG"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Perfil de GitHub de Alexis Sierra"
            class="p-2.5 rounded-xl bg-white border border-slate-200 text-[#181717] hover:border-brand-300 hover:bg-slate-50 hover:shadow-md transition-all min-w-[44px] min-h-[44px] flex items-center justify-center shadow-sm"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              ></path>
            </svg>
          </a>

          <!-- LinkedIn (Original Blue #0A66C2) -->
          <a
            href="https://www.linkedin.com/in/alexis-sierra-852016333/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Perfil de LinkedIn de Alexis Sierra"
            class="p-2.5 rounded-xl bg-white border border-slate-200 text-[#0A66C2] hover:border-brand-300 hover:bg-slate-50 hover:shadow-md transition-all min-w-[44px] min-h-[44px] flex items-center justify-center shadow-sm"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.2a1.64 1.64 0 0 0-1.64 1.63c0 .91.74 1.64 1.64 1.64s1.63-.73 1.63-1.64A1.63 1.63 0 0 0 7.83 6.2z"
              ></path>
            </svg>
          </a>

          <!-- Instagram (Original Gradient / Colors) -->
          <a
            href="https://www.instagram.com/alexis_joseg?stkn=aGdwNHVqaDJ3Nmhq"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Perfil de Instagram de Alexis Sierra"
            class="p-2.5 rounded-xl bg-white border border-slate-200 hover:border-pink-300 hover:bg-pink-50/50 hover:shadow-md transition-all min-w-[44px] min-h-[44px] flex items-center justify-center shadow-sm group/ig"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
              <defs>
                <radialGradient id="hero-ig-radial" cx="30%" cy="107%" r="150%">
                  <stop offset="0%" stop-color="#FFD600"></stop>
                  <stop offset="15%" stop-color="#FF7A00"></stop>
                  <stop offset="50%" stop-color="#FF0069"></stop>
                  <stop offset="70%" stop-color="#D300C5"></stop>
                  <stop offset="100%" stop-color="#7638FA"></stop>
                </radialGradient>
              </defs>
              <rect
                x="2"
                y="2"
                width="20"
                height="20"
                rx="5.5"
                stroke="url(#hero-ig-radial)"
                stroke-width="2"></rect>
              <circle
                cx="12"
                cy="12"
                r="4.2"
                stroke="url(#hero-ig-radial)"
                stroke-width="2"></circle>
              <circle cx="17.5" cy="6.5" r="1.3" fill="url(#hero-ig-radial)"
              ></circle>
            </svg>
          </a>

          <!-- Gmail / Email (Original Red #EA4335) -->
          <a
            href="mailto:alexisjose155568@gmail.com"
            aria-label="Enviar correo a Alexis Sierra"
            class="p-2.5 rounded-xl bg-white border border-slate-200 text-[#EA4335] hover:border-brand-300 hover:bg-slate-50 hover:shadow-md transition-all min-w-[44px] min-h-[44px] flex items-center justify-center shadow-sm"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Typewriter Animation implementation
  const typewriterElement = document.getElementById("typewriter-text");
  const textToType = "Crea una aplicación poderosa para su marca";
  let charIndex = 0;
  let isDeleting = false;
  const typingSpeed = 80;
  const deletingSpeed = 40;
  const pauseEnd = 2400;
  const pauseStart = 500;

  function typeWriter() {
    if (!typewriterElement) return;

    if (!isDeleting) {
      // Typing forward
      typewriterElement.textContent = textToType.substring(0, charIndex + 1);
      charIndex++;

      if (charIndex === textToType.length) {
        // Finished typing full text, pause before deleting
        isDeleting = true;
        setTimeout(typeWriter, pauseEnd);
        return;
      }
      setTimeout(typeWriter, typingSpeed);
    } else {
      // Deleting backwards
      typewriterElement.textContent = textToType.substring(0, charIndex - 1);
      charIndex--;

      if (charIndex === 0) {
        // Finished deleting, pause before typing again
        isDeleting = false;
        setTimeout(typeWriter, pauseStart);
        return;
      }
      setTimeout(typeWriter, deletingSpeed);
    }
  }

  // Initialize on load
  document.addEventListener("DOMContentLoaded", () => {
    typeWriter();
  });
  // Fallback if DOM already loaded
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    typeWriter();
  }
</script>
