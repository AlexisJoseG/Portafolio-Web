---

<section
  data-aos="fade-up"
  data-aos-duration="800"
  id="contacto"
  class="py-16 sm:py-24 relative bg-slate-50/70 border-t border-slate-200/60 overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
     
      <h2 class="text-2xl sm:text-4xl font-bold text-slate-900 mt-2 tracking-tight">
        Contacto Directo & Redes
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        ¿Tienes un proyecto en mente o buscas incorporar talento frontend? Estoy disponible.
      </p>
      <div class="w-16 h-1 bg-[#023e7d] mx-auto mt-3 rounded-full"></div>
    </div>

    <!-- Contact Cards Grid (Accessible 44px min touch targets) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
      {contactChannels.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith('mailto:') ? '_self' : '_blank'}
          rel="noopener noreferrer"
          class={`glass-panel glass-panel-hover p-5 sm:p-6 rounded-2xl border bg-white flex flex-col items-center text-center justify-between group min-h-[250px] transition-all duration-300 shadow-sm ${
            c.highlight
              ? 'border-blue-300 ring-2 ring-blue-100 shadow-md'
              : 'border-slate-200/90'
          }`}
        >
          <div class="flex flex-col items-center w-full">
            <!-- Centered & Larger Icon Container -->
            <div class={`w-16 h-16 sm:w-18 sm:h-18 rounded-2xl ${c.iconBg} border flex items-center justify-center p-3 mb-4 group-hover:scale-110 transition-transform shadow-sm`} set:html={c.icon}>
            </div>

            <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
              {c.name}
            </h3>

            <p class="text-xs font-mono font-medium text-brand-700 truncate max-w-full mt-0.5">
              {c.handle}
            </p>

            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              {c.description}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-center gap-1.5 text-xs font-semibold text-brand-700 group-hover:text-blue-600 min-h-[44px] w-full">
            <span>{c.action}</span>
            <span class="transform group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Direct CTA Banner with Blue #023e7d Button -->
    <div class="mt-12 glass-panel rounded-3xl p-8 sm:p-10 border border-blue-200/80 bg-white text-center space-y-4 max-w-3xl mx-auto shadow-md">
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900">
        ¿Listo para crear algo increíble juntos?
      </h3>
      <p class="text-sm text-slate-600 max-w-xl mx-auto">
        Haz clic abajo y envíame un mensaje directo a WhatsApp con los detalles de tu consulta.
      </p>
      <div class="pt-2">
        <a
          href="https://wa.me/584245202701?text=Hola%20Alexis,%20vi%20tu%20portafolio%20y%20me%20gustaría%20contactarte."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-8 py-4 text-base font-bold text-white bg-[#023e7d] hover:bg-[#0353a4] rounded-xl transition-all duration-200 transform hover:scale-105 shadow-lg shadow-brand-700/25 min-h-[44px]"
        >
          <span>Iniciar Chat en WhatsApp</span>
          <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>


